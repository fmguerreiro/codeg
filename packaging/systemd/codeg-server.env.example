# Install to /etc/codeg/codeg-server.env, root-owned mode 0600: systemd reads
# it as root, so the service user never sees the token.
# `systemctl restart codeg-server` after editing.

# Web assets, as placed by install.sh. Without this only the HTTP API answers.
CODEG_STATIC_DIR=/usr/local/share/codeg/web

# Database, logs, uploads. Matches StateDirectory=codeg in the unit. Do not
# also set CODEG_HOME: uploads would split off from the database.
CODEG_DATA_DIR=/var/lib/codeg

# Web/mobile client token. If unset the server generates one, persists it, and
# prints it to the journal. Generate your own: openssl rand -hex 32
#CODEG_TOKEN=

# Set explicitly rather than inherited: the built-in default differs by
# version. 127.0.0.1 expects a reverse proxy in front; use 0.0.0.0 to let
# other machines reach the server directly.
CODEG_HOST=127.0.0.1
CODEG_PORT=3080

# Log filter (RUST_LOG syntax) and the log budget under CODEG_DATA_DIR.
#CODEG_LOG=info
#CODEG_LOG_MAX_BYTES=
#CODEG_LOG_MAX_FILES=

# Seconds before idle agent connections are dropped (default 60; 0 disables).
#CODEG_ACP_IDLE_TIMEOUT_SECS=60

# Strict mode exits 2 on an invalid quota, which the unit does not restart.
#CODEG_UPLOAD_MAX_TOTAL_BYTES=
#CODEG_UPLOAD_QUOTA_STRICT=0
